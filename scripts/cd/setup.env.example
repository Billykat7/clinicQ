# =============================================================================
# setup.env.example — Server bootstrap configuration template
# =============================================================================
# Copy to setup.env (ignored by git) and fill in real values:
#   cp setup.env.example setup.env
#   chmod 600 setup.env
# Then run:  ./server_setup_env.sh
# =============================================================================

# ── Passwords ─────────────────────────────────────────────────────────────────

# New password for the root user
ROOT_PASS="CHANGE_ME"

# Password for the new 'deployer' user
DEPLOYER_PASS="CHANGE_ME"

# ── SSH ───────────────────────────────────────────────────────────────────────

# Email address embedded as a comment in the generated SSH keys
SSH_EMAIL="you@example.com"

# Your LOCAL machine's public SSH key — paste the full output of:
#   cat ~/.ssh/id_ed25519.pub   (or id_rsa.pub)
LOCAL_PUBLIC_KEY="CHANGE_ME"

# ── GitHub Actions Runner ─────────────────────────────────────────────────────

GITHUB_REPO_URL="https://github.com/ORG/REPO"

# Registration token: Repo → Settings → Actions → Runners → New self-hosted runner
RUNNER_TOKEN="CHANGE_ME"

RUNNER_LABEL="btkmaps"

RUNNER_VERSION="2.333.1"

# ── Project ───────────────────────────────────────────────────────────────────

PROJECT_NAME="maps"

# ── Domain & SSL ──────────────────────────────────────────────────────────────

DOMAIN="maps.example.com"

DOMAIN_EMAIL="deployer@example.com"
