# BK ClinicQ local settings. Copy to .env (cp .env.example .env); .env itself is git-ignored.
#
# For now this file holds only the two connection URLs for the local Docker stack
# (infra/docker/docker-compose.yml, started with `make db-up`). Every other setting has a safe
# development default in src/core/config.py; Issue 12 extends this file to cover all of them.
#
# The values match the compose defaults (DB_USER, DB_PASSWORD, DB_NAME, DB_PORT, REDIS_PORT). If you
# move the stack to another port (DB_PORT=5433 in infra/docker/.env), change the port here too.
# The API container (`make docker-up`) is given the same URLs with the host swapped for the service
# name (db, redis), so keep localhost here.

# PostgreSQL 18 + PostGIS.
DATABASE_URL=postgresql://btk_user:change-me@localhost:5432/btk

# Redis 8. Nothing in the app reads this yet; the Redis readiness check (Issue 6) is the first reader.
REDIS_URL=redis://localhost:6379/0
