# BK ClinicQ settings: every one the app reads, generated from src/core/config.py (Issue 12).
#
#   cp .env.example .env    then `make run`: a local development app against the compose stack
#                           (`make db-up`), with no other edit.
#
# Generated: change the Field in src/core/config.py, then run `make env-example`.
# tests/unit/platform/test_env_example.py fails while this file and the Settings class disagree.
#
# Each setting is listed with its default on a commented `# NAME=value` line, so a copied .env
# keeps following the code's defaults; uncomment a line to override one. `# NAME=` has no default.
# Only the connection URLs are active, pointing at the compose stack. Secrets here are blank or
# development-only, and the app refuses the development ones outside development. Real values live
# in the host's .env and in GitHub Environments, never in this repository
# (docs/CICD/ENVIRONMENTS.md). Check an env file without starting the app:
#   python scripts/check_config.py .env --environment production

# Application name.
# APP_NAME=BK ClinicQ

# Application version, reported at /health. The release image sets it from the tag (Issue 10); leave
# it out of env files. Also read as APP_VERSION.
# VERSION=0.1.0

# The commit the running code was built from, reported at /health. Set by the image build (Issue
# 10); never set it in an env file, or it would mislabel the image it runs in.
# GIT_SHA=unknown

# Runtime environment.
# ENVIRONMENT=development

# FastAPI debug mode: tracebacks in error responses. Development only; the app refuses to start with
# it in staging or production.
# DEBUG=false

# Origins allowed to call the app from a page on another origin, comma-separated, e.g.
# 'https://clinicq.example.org'. Empty: same-origin only, no CORS headers at all. '*' admits every
# site and is refused outside development.
# CORS_ORIGINS=

# Minimum level the console writes. INFO unless a deployment says otherwise.
# LOG_LEVEL=INFO

# Console log format: json (one object per line) or text.
# LOG_FORMAT=json

# Where unhandled exceptions are sent: a Sentry or GlitchTip project DSN. Empty: error tracking is
# off.
# SENTRY_DSN=

# Share of requests sent as performance traces, 0 to 1. 0 sends errors only, which fits the free
# tiers.
# SENTRY_TRACES_SAMPLE_RATE=0.0

# Serve Prometheus metrics (request rate, latency, errors) at /metrics.
# METRICS_ENABLED=false

# Bearer token /metrics requires. Required outside development while metrics are on: traffic figures
# are not for everyone. Secret: never commit a real value.
# METRICS_TOKEN=

# Serve GET /health/error-tracking-test, which raises on purpose, to prove error tracking works end
# to end. Refused in production.
# ERROR_TRACKING_TEST_ROUTE=false

# PEM cert whose expiry is reported in /health. Unset → no cert block. Also read as CERT_PATH.
# TLS_CERT_PATH=

# This project's name in shared infrastructure, and the first segment of every S3 object key:
# {slug}/{dev|uat|prod}/{logs|docs|...}/.... Lowercase letters, digits and hyphens.
# PROJECT_SLUG=clinicq

# Upload structured logs to S3.
# AWS_S3_LOGGING_ENABLED=false

# S3 bucket for structured logs.
# AWS_S3_BUCKET=

# Create AWS_S3_BUCKET in AWS_S3_REGION the first time the app writes to it, if it does not exist
# yet. Needs s3:CreateBucket; a bucket that exists but is not readable is never created over.
# AWS_S3_CREATE_BUCKET_IF_MISSING=false

# AWS region for S3. Also read as AWS_REGION.
# AWS_S3_REGION=af-south-1

# Log path segment for the S3 key: api or web.
# AWS_S3_LOG_PATH=api

# Minimum level uploaded to S3.
# AWS_S3_LOG_LEVEL=WARNING

# AWS access key ID. Secret: never commit a real value.
# AWS_ACCESS_KEY_ID=

# AWS secret access key. Secret: never commit a real value.
# AWS_SECRET_ACCESS_KEY=

# Verify SSL certificates for AWS/S3.
# AWS_SSL_CERT_ENABLED=true

# Trust X-Forwarded-For for client IP.
# TRUST_PROXY_HEADERS=false

# Trusted reverse-proxy hops in front of the app.
# TRUSTED_PROXY_HOPS=1

# PostgreSQL URL, or built from DB_USER/DB_PASSWORD/DB_HOST/DB_NAME.
DATABASE_URL=postgresql://btk_user:change-me@localhost:5432/btk

# DB user. Used to build DATABASE_URL.
# DB_USER=

# DB password. Used to build DATABASE_URL. Secret: never commit a real value.
# DB_PASSWORD=

# DB host derived from DATABASE_URL (DB_HOST env is ignored when URL is set).
# DB_HOST=

# DB name derived from DATABASE_URL (DB_NAME env is ignored when URL is set).
# DB_NAME=

# Optional query string for DB URL.
# DB_OPTS=

# PostgreSQL schema for application tables.
# DB_SCHEMA=clinicq

# SQLAlchemy async driver for the request-path engine, used to build database_url_async from
# database_url.
# DB_ASYNC_DRIVER=asyncpg

# Async engine connection-pool size.
# DB_ASYNC_POOL_SIZE=5

# Async engine connections allowed beyond the pool size under burst.
# DB_ASYNC_MAX_OVERFLOW=10

# Seconds a request waits for a free async connection before failing rather than queueing forever.
# DB_POOL_TIMEOUT_SECONDS=30

# PostgreSQL statement_timeout applied to async connections; a runaway query is cancelled instead of
# holding a loop worker. 0 disables.
# DB_STATEMENT_TIMEOUT_SECONDS=30

# PostgreSQL lock_timeout applied to async connections; a blocked lock acquisition fails fast rather
# than stalling. 0 disables.
# DB_LOCK_TIMEOUT_SECONDS=10

# Enable authentication dependencies.
# AUTH_ENABLED=true

# HS256 signing secret. Secret: never commit a real value.
# JWT_SECRET=clinicq-dev-secret-change-me-min-32-chars

# JWT signing algorithm.
# JWT_ALGORITHM=HS256

# bcrypt cost factor for password hashing. The default 12 is a deliberate work factor; it may be
# lowered (e.g. 4) only in development/tests to keep bcrypt-heavy suites fast — a production guard
# forbids < 12 outside development.
# BCRYPT_ROUNDS=12

# Secret used to derive the Fernet key that encrypts personal fields at rest (e.g. a government ID
# number). When empty, the key is derived from JWT_SECRET so development and tests need no extra
# config. Secret: never commit a real value.
# FIELD_ENCRYPTION_KEY=

# Comma-separated field-encryption secrets, newest first, for zero-downtime key rotation (Issue
# #78). When set it fully specifies the key list: new data is encrypted with the first (primary)
# key, and every listed key is tried on decrypt so ciphertext under a retired key still reads during
# migration. When empty the app falls back to the single FIELD_ENCRYPTION_KEY / JWT_SECRET key. See
# docs/CICD/KEY-ROTATION.md. Secret: never commit a real value.
# FIELD_ENCRYPTION_KEYS=

# Access token lifetime in minutes.
# JWT_ACCESS_EXPIRE_MINUTES=15

# Refresh token lifetime in days. Secret: never commit a real value.
# REFRESH_TOKEN_EXPIRE_DAYS=7

# How long after a refresh token is rotated a second presentation of it is treated as a concurrent
# refresh (two tabs whose requests crossed) rather than a replay: it gets a fresh access token and
# no new refresh token, and revokes nothing. After the window a replay revokes the whole token
# family. 0 turns the window off.
# REFRESH_REUSE_GRACE_SECONDS=5

# Activation link validity in hours.
# ACTIVATION_LINK_EXPIRE_HOURS=48

# Password reset link validity in hours. Secret: never commit a real value.
# PASSWORD_RESET_LINK_EXPIRE_HOURS=2

# Staff invitation validity in hours — long enough to survive a weekend, short enough that a
# forwarded link is not a standing way in (Issue 22; env: STAFF_INVITE_EXPIRE_HOURS).
# STAFF_INVITE_EXPIRE_HOURS=72

# Email-change confirmation link validity in hours.
# EMAIL_CHANGE_LINK_EXPIRE_HOURS=2

# Minimum minutes between verification-email resends per user.
# VERIFICATION_RESEND_COOLDOWN_MINUTES=5

# Enable self-registration signup + activation.
# SIGNUP_ENABLED=false

# Enable OTP email sign-in endpoints.
# AUTH_OTP_LOGIN_ENABLED=true

# Enable password sign-in endpoint. Secret: never commit a real value.
# AUTH_PASSWORD_LOGIN_ENABLED=true

# OTP validity in minutes.
# OTP_TTL_MINUTES=10

# OTP code length in digits.
# OTP_LENGTH=6

# Max OTP requests per email per window.
# OTP_RATE_LIMIT_PER_EMAIL=5

# Max OTP requests per IP per window.
# OTP_RATE_LIMIT_PER_IP=20

# OTP rate-limit window in minutes.
# OTP_RATE_LIMIT_WINDOW_MINUTES=15

# Max patient OTP requests per phone number per window, so one number cannot be flooded with texts.
# OTP_RATE_LIMIT_PER_PHONE=5

# Wrong guesses a one-time code takes before it locks and a new one must be requested; applies to
# email and phone codes alike.
# OTP_MAX_VERIFY_ATTEMPTS=5

# Seconds after a phone code is sent before another may be requested.
# OTP_RESEND_COOLDOWN_SECONDS=60

# How long a patient's web session lasts after a phone OTP, in hours: one clinic day by default.
# PATIENT_SESSION_HOURS=12

# httpOnly cookie carrying a patient's session.
# PATIENT_SESSION_COOKIE_NAME=bk_clinicq_patient_session

# Max password sign-in attempts per email per window. Secret: never commit a real value.
# PASSWORD_LOGIN_RATE_LIMIT_PER_EMAIL=10

# Max password sign-in attempts per IP per window. Secret: never commit a real value.
# PASSWORD_LOGIN_RATE_LIMIT_PER_IP=30

# Password sign-in rate-limit window in seconds. Secret: never commit a real value.
# PASSWORD_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# Redis the app depends on; checked by /health/ready. Unset: skipped.
REDIS_URL=redis://localhost:6379/0

# Connect and read timeout of the readiness Redis ping, in seconds. Short, so a hung Redis fails
# readiness quickly.
# REDIS_PROBE_TIMEOUT_SECONDS=1.0

# Where rate-limit windows live: memory or redis.
# RATE_LIMIT_BACKEND=memory

# Redis URL for the shared rate-limit store.
# RATE_LIMIT_REDIS_URL=

# Max signed download links minted per IP per window.
# SIGNED_LINK_MINT_RATE_LIMIT_PER_IP=60

# Signed-link mint rate-limit window in seconds.
# SIGNED_LINK_MINT_RATE_LIMIT_WINDOW_SECONDS=60

# Socket timeout for the shared rate-limit store, in seconds. Deliberately short: the limiter is on
# the hot path of every sign-in, so a slow store must degrade fast, not queue requests.
# RATE_LIMIT_REDIS_TIMEOUT_SECONDS=0.25

# If set, refresh sessions older than this many days from session_started_at require sign-in again.
# None disables.
# SESSION_ABSOLUTE_MAX_DAYS=

# If set, revoke a refresh session when last_seen_at is older than this many minutes (server-
# enforced idle). None disables.
# SESSION_SERVER_IDLE_TIMEOUT_MINUTES=

# SMTP server host for transactional email.
# SMTP_HOST=

# SMTP server port.
# SMTP_PORT=587

# Use STARTTLS for SMTP. Also read as SMTP_TLS.
# SMTP_USE_TLS=true

# SMTP username.
# SMTP_USER=

# SMTP password. Secret: never commit a real value.
# SMTP_PASSWORD=

# Default From address for transactional email.
# SMTP_FROM_EMAIL=noreply@clinicq.bkatalayi.com

# The SMS feature flag. Off (the default), no SMS is handed to any provider: patient messages go by
# web push or are recorded as not sent, and sign-in by SMS code answers 503. Set true to send SMS
# through SMS_PROVIDER. The operators' kill switch can still stop SMS at run time while this is on.
# SMS_ENABLED=false

# SMS provider backing the SMS channel. 'logging' logs and returns a synthetic id so the app runs
# without an SMS account; 'fake' is the in-memory test double; 'africas_talking' is the gateway
# (Issue 65).
# SMS_PROVIDER=logging

# Sender id / from-number for outbound SMS.
# SMS_FROM=

# Africa's Talking account username; 'sandbox' is the free test account.
# AFRICAS_TALKING_USERNAME=sandbox

# Africa's Talking API key. A secret: server-side only, never logged. Secret: never commit a real
# value.
# AFRICAS_TALKING_API_KEY=

# Send through the gateway's sandbox, which delivers to its simulator and charges nothing. True
# unless production turns it off.
# SMS_SANDBOX=true

# How many SMS one clinic may send in a Johannesburg day, unless the clinic has its own cap.
# SMS_SITE_DAILY_CAP=300

# How many queue SMS one patient may be sent in a Johannesburg day.
# SMS_PATIENT_DAILY_CAP=8

# The most billable parts one SMS may be split into; a longer message is refused, not sent. Queue
# messages are written to fit one.
# SMS_MAX_SEGMENTS=2

# Secret in the delivery-receipt callback URL registered with the gateway, which does not sign its
# callbacks. Unset disables the receipt webhook. Secret: never commit a real value.
# SMS_WEBHOOK_TOKEN=

# How many delivery attempts a notification gets before it is dead-lettered.
# NOTIFICATION_MAX_ATTEMPTS=5

# Base seconds for exponential backoff between delivery retries — the wait before attempt n is base
# * 2**(n-1).
# NOTIFICATION_RETRY_BASE_SECONDS=60

# How often the notification retry sweep runs to re-attempt due failures.
# NOTIFICATION_RETRY_INTERVAL_MINUTES=5

# When a patient notification is handed to its transport after the commit. 'background' returns the
# request at once and delivers on a worker pool; 'inline' delivers before the committing call
# returns.
# NOTIFICATION_DISPATCH=background

# Worker threads delivering patient notifications in the background.
# NOTIFICATION_DISPATCH_WORKERS=4

# How long the retry sweep leaves a new patient notification to its post-commit delivery before
# taking it over, so the two never send one message twice.
# NOTIFICATION_DISPATCH_GRACE_SECONDS=60

# The share of a transport's attempted messages (sent, delivered or dead) that may be dead-lettered
# in the alert window before the team is alerted.
# NOTIFICATION_FAILURE_ALERT_RATE=0.25

# How many attempted messages a transport needs in the window before its failure rate can alert, so
# two failures out of three at night are not an incident.
# NOTIFICATION_FAILURE_ALERT_MIN_ATTEMPTS=20

# The window the failure rate is measured over, and the most often one transport can alert.
# NOTIFICATION_FAILURE_ALERT_WINDOW_MINUTES=60

# How often the delivery failure watch runs.
# NOTIFICATION_FAILURE_WATCH_MINUTES=5

# ISO 4217 currency every recorded notification cost is in.
# NOTIFICATION_COST_CURRENCY=ZAR

# VAPID application server public key, base64url, uncompressed P-256 point: given to browsers when
# they subscribe.
# WEB_PUSH_VAPID_PUBLIC_KEY=

# VAPID private key, base64url raw P-256 scalar. A secret: server-side only, never logged. Secret:
# never commit a real value.
# WEB_PUSH_VAPID_PRIVATE_KEY=

# Contact push services use to reach the operator: a mailto: address or an https: URL.
# WEB_PUSH_VAPID_SUBJECT=

# Push service hosts (and their subdomains) a subscription endpoint may point at. The server POSTs
# to the endpoint a browser gave it, so anything else is refused.
# WEB_PUSH_ALLOWED_HOSTS=fcm.googleapis.com,push.services.mozilla.com,push.apple.com,notify.windows.com

# Refuse a subscription endpoint that is not https. Only a local test push service turns this off.
# WEB_PUSH_REQUIRE_HTTPS=true

# How long a push service keeps a message for a phone that is offline: 'you are next' is no use an
# hour later.
# WEB_PUSH_TTL_SECONDS=900

# Seconds to wait for a push service to accept a message.
# WEB_PUSH_TIMEOUT_SECONDS=5.0

# Shared secret a delivery-status webhook must present in the 'X-Webhook-Secret' header before a
# provider callback is accepted. When unset, the webhook endpoint is disabled. Secret: never commit
# a real value.
# NOTIFICATION_WEBHOOK_SECRET=

# Externally reachable base URL for links in outbound mail, e.g. 'https://clinicq.bkatalayi.com'.
# When unset, the List-Unsubscribe header is omitted.
# PUBLIC_BASE_URL=

# How long a login-free unsubscribe link stays valid, in days — long-lived because email lingers in
# inboxes.
# UNSUBSCRIBE_LINK_EXPIRE_DAYS=365

# httpOnly cookie carrying the JWT access token. Secret: never commit a real value.
# ACCESS_TOKEN_COOKIE_NAME=bk_clinicq_access_token

# httpOnly cookie carrying the opaque refresh token. Secret: never commit a real value.
# REFRESH_TOKEN_COOKIE_NAME=bk_clinicq_refresh_token

# Non-httpOnly CSRF cookie for double-submit.
# CSRF_COOKIE_NAME=bk_clinicq_csrf

# Max accepted profile-picture upload size in bytes.
# AVATAR_MAX_BYTES=5242880

# Filesystem base dir for stored profile pictures.
# AVATAR_STORAGE_DIR=var/avatars

# Side length in pixels of the stored square avatar; larger uploads are centre-cropped and
# downscaled to it.
# AVATAR_MAX_DIMENSION_PX=512

# Cache-Control max-age for a served avatar. Safe to cache because a replacement gets a new key (and
# so a new URL).
# AVATAR_CACHE_MAX_AGE_SECONDS=86400

# Max accepted document upload size in bytes.
# DOCUMENT_MAX_BYTES=26214400

# Filesystem base dir for stored documents.
# DOCUMENT_STORAGE_DIR=var/documents

# Lifetime of a signed document download link in seconds.
# DOCUMENT_LINK_EXPIRE_SECONDS=300

# Scan document bytes for malware on ingest. When false, ingest records the scan as 'skipped' and
# stores the bytes unscanned.
# DOCUMENT_VIRUS_SCAN_ENABLED=true

# Virus scanner backing document ingest. 'eicar' flags the industry-standard EICAR test file and
# passes everything else so the app runs without an antivirus daemon; 'fake' is the in-memory test
# double.
# DOCUMENT_SCANNER=eicar

# Days a private visit note is kept before the nightly sweep deletes it; at most the platform's
# 90-day ceiling.
# VISIT_NOTE_RETENTION_DAYS=30

# Hour of day (Africa/Johannesburg, 0-23) the nightly visit-note retention sweep runs.
# VISIT_NOTE_RETENTION_SWEEP_HOUR=2

# Hour of day (Africa/Johannesburg, 0-23) the daily document retention sweep runs, purging expired
# documents and recording each deletion.
# DOCUMENT_RETENTION_SWEEP_HOUR=3

# Enable the e-signature signing flow. When false, leases are signed on paper and the send endpoints
# are unavailable.
# ESIGN_ENABLED=true

# E-signature provider backing the signing flow. 'local' is a self-contained provider that runs the
# whole flow without an external account; 'fake' is the in-memory test double.
# ESIGN_PROVIDER=local

# Shared secret the provider signs its webhooks with, verified as an HMAC-SHA256 of the raw request
# body. A credential — never logged. When empty the webhook endpoint 404s, so the endpoint's
# existence is not revealed. Secret: never commit a real value.
# ESIGN_WEBHOOK_SECRET=

# Days a signing request stays open before it is considered expired; stamped on the envelope's
# expires_at when it is sent.
# ESIGN_ENVELOPE_EXPIRE_DAYS=14

# Start the background job scheduler on app startup. Set false to disable all scheduled jobs.
# SCHEDULER_ENABLED=true

# Record which grants are actually exercised, for the unused-grant pruning worklist. On by default;
# a deployment that does not want it should not have to patch code.
# PERMISSION_USAGE_ENABLED=true

# How often the buffered grant-usage hits are flushed to permission_usage. Longer windows coalesce
# more and lose more on shutdown; both are acceptable for advisory data.
# PERMISSION_USAGE_FLUSH_MINUTES=5

# The 'granted, never used in N days' worklist threshold shown on the permissions matrix.
# PERMISSION_USAGE_UNUSED_DAYS=90

# Enable the Stripe payment gateway and its webhook.
# STRIPE_ENABLED=false

# Stripe secret API key (sk_test_… / sk_live_…); server-side only, never logged. Secret: never
# commit a real value.
# STRIPE_SECRET_KEY=

# Stripe publishable key (pk_test_… / pk_live_…) handed to the client to confirm a PaymentIntent.
# STRIPE_PUBLISHABLE_KEY=

# Signing secret (whsec_…) used to verify webhook signatures; never logged. Secret: never commit a
# real value.
# STRIPE_WEBHOOK_SECRET=

# Enable the Paystack payment gateway and its webhook.
# PAYSTACK_ENABLED=false

# Paystack secret API key (sk_test_… / sk_live_…); server-side only, never logged. Also the HMAC-
# SHA512 webhook signing key. Secret: never commit a real value.
# PAYSTACK_SECRET_KEY=

# Paystack public key (pk_test_… / pk_live_…) handed to the client to open the checkout.
# PAYSTACK_PUBLIC_KEY=

# Which service turns a typed address into a coordinate, server-side. 'none' disables the lookup and
# site creation takes an explicit coordinate; 'nominatim' uses the OpenStreetMap search API or a
# self-hosted instance.
# GEOCODING_PROVIDER=none

# Base URL of the geocoding service. Point it at a self-hosted Nominatim to keep clinic addresses
# inside the deployment.
# GEOCODING_BASE_URL=https://nominatim.openstreetmap.org

# Descriptive User-Agent identifying this deployment to the geocoding service, e.g. 'ClinicQ/0.4
# (ops@example.org)'. Nominatim's usage policy requires one, so the lookup is refused while this is
# empty.
# GEOCODING_USER_AGENT=

# ISO 3166-1 alpha-2 code the geocoder is restricted to. Matches the operating-area bounding box in
# src.commons.geo.
# GEOCODING_COUNTRY_CODE=za

# How long to wait for the geocoding service before giving up and asking the operator for the
# coordinate.
# GEOCODING_TIMEOUT_SECONDS=5.0

# Offer 'Join the queue' on the clinic detail page when a clinic is open and has a queue that takes
# remote joins, and let the join page sign a patient in and join. While off, the button is shown
# disabled with the reason, and the join page says the same with no form.
# PATIENT_JOIN_ENABLED=false

# Seconds a dashboard action pressed while the clinic could not be reached is held before it is
# reported as not sent rather than sent late.
# DASHBOARD_OUTBOX_EXPIRY_SECONDS=120

# Minutes a waiting patient may wait before the front desk card is marked as having someone stuck.
# DASHBOARD_STUCK_WAIT_MINUTES=45

# With REDIS_URL set, fan live events (dashboards, waiting-room boards) out to every instance
# through Redis pub/sub, so a call made on one worker reaches screens connected to another.
# LIVE_EVENTS_FANOUT=true

# Minutes a paired waiting-room board may go without a heartbeat before the team is alerted that its
# screen may be dark.
# DISPLAY_DEVICE_SILENT_MINUTES=10

# Minutes the code on an unpaired board's screen stays valid before the box shows a new one.
# DISPLAY_PAIRING_CODE_MINUTES=10

# The httpOnly cookie a kiosk box keeps its device secret in.
# DISPLAY_DEVICE_COOKIE_NAME=clinicq_display

# Incoming webhook of the team channel (Slack or Discord) the application posts operational alerts
# to, such as a silent waiting-room board; the same channel Issue 14's monitoring uses. Empty:
# alerts are logged only.
# TEAM_WEBHOOK_URL=

# Which service TEAM_WEBHOOK_URL belongs to: slack or discord.
# TEAM_WEBHOOK_KIND=slack

# Show the waiting-room board's line of general health notices, one at a time, under the queues.
# BOARD_HEALTH_TICKER=true

# Show private clinics' self-reported payment methods and medical aids in discovery, and let
# patients filter by them under Private.
# PAYMENT_FILTER_ENABLED=false

# Record anonymous discovery events (searches, clinic views, joins) for view-to-join reports. A
# clinic can also opt out on its own.
# DISCOVERY_ANALYTICS_ENABLED=true

# Max discovery searches per client IP per window, to stop copying the directory. Loose, because
# mobile carriers share addresses.
# DISCOVERY_SEARCH_RATE_LIMIT_PER_IP=300

# Max discovery searches per discovery session per window.
# DISCOVERY_SEARCH_RATE_LIMIT_PER_SESSION=60

# Discovery search rate-limit window in seconds.
# DISCOVERY_SEARCH_RATE_LIMIT_WINDOW_SECONDS=60

# How long a queue snapshot lives in Redis before it expires. Short, because a miss only costs a
# recount.
# QUEUE_SNAPSHOT_TTL_SECONDS=15

# The oldest a snapshot may be and still be shown to a patient, in seconds. Older ones are
# recounted. M5's bound is 30.
# QUEUE_SNAPSHOT_MAX_AGE_SECONDS=30

# How often the reconciliation sweep compares every snapshot with a fresh count and repairs any
# drift, in seconds.
# QUEUE_SNAPSHOT_RECONCILE_SECONDS=60

# Max remote joins per phone number per window, across every queue and clinic. A patient joins one
# or two queues; a script joins many.
# QUEUE_JOIN_RATE_LIMIT_PER_PHONE=6

# Max web joins per client IP per window. Loose, because a mobile carrier puts a whole township
# behind a few addresses.
# QUEUE_JOIN_RATE_LIMIT_PER_IP=30

# Queue join rate-limit window in seconds.
# QUEUE_JOIN_RATE_LIMIT_WINDOW_SECONDS=3600

# Max remote joins (web, USSD, WhatsApp) one clinic accepts in a service day, whatever its queues'
# own capacities. Bounds a bulk attack on one clinic; walk-ins are not counted.
# QUEUE_JOIN_SITE_DAILY_CAP=1500

# Seconds after a call during which staff may undo it and put the patient back in their place.
# QUEUE_CALL_UNDO_SECONDS=30

# Seconds after issuing a walk-in during which the desk may undo it, while the patient is still at
# the counter.
# QUEUE_WALK_IN_UNDO_SECONDS=120

# Minutes a called patient has to arrive before being recalled once, and again before being marked a
# no-show, unless the clinic or the queue sets its own.
# QUEUE_RECALL_TIMEOUT_MINUTES=5

# How often the recall timer sweep checks called tickets, in seconds. A timeout fires at most this
# late.
# QUEUE_RECALL_SWEEP_SECONDS=30

# How often the virtual waiting room checks whether a travelling patient should leave, in seconds. A
# time-to-leave alert is at most this late, well inside its 10-minute arrival margin.
# VIRTUAL_WAITING_SWEEP_SECONDS=30
