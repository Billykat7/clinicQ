# ClinicQ staging: the settings that differ from the code's default and are not secret.
#
# Read deploy/env/README.md first. In short: everything here is a decision that belongs in review;
# no credential is ever in this file, and a test enforces that. The secret settings are merged in
# on the host at deploy time from the SOPS-encrypted file in Billykat7/infra.
#
# Staging runs the same image as production under the same rules, against its own database and
# with test payment keys only. It differs from production in three places, all below: it may serve
# the deliberate-failure route while error tracking is being proven, it is a different host name,
# and it is a different port on the same machine.
# docs/CICD/ENVIRONMENTS.md is the table of what differs between environments, and why.

# ── What environment this is ──────────────────────────────────────────────────────────────────
# Staging is held to the production rules, not to development's: a real JWT secret, bcrypt 12 or
# more, no debug, no wildcard CORS, no /dev pages. Staging that is laxer than production does not
# test production.
ENVIRONMENT=staging

# ── Behind the gateway ────────────────────────────────────────────────────────────────────────
TRUST_PROXY_HEADERS=true
PUBLIC_BASE_URL=https://staging.clinicq.bkatalayi.com

# ── Observability ─────────────────────────────────────────────────────────────────────────────
METRICS_ENABLED=true
AWS_S3_LOGGING_ENABLED=true
SENTRY_TRACES_SAMPLE_RATE=0.0

# The route that fails on purpose, to prove errors reach Sentry (Issue 14). Allowed here and
# refused in production by the boot guard, so this line can never be copied across by accident.
ERROR_TRACKING_TEST_ROUTE=true

# ── The compose file's own keys (not app settings; infra/docker/docker-compose.prod.yml) ──────
# A different port from production's 8011, so both run on the one platform host without meeting.
# deploy.sh smoke-tests a candidate on APP_PORT + 1000, so 8012 reserves 9012 as well.
APP_PORT=8012

DOMAIN=staging.clinicq.bkatalayi.com

PROJECT_SLUG=clinicq
DB_SCHEMA=clinicq
