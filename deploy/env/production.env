# ClinicQ production: the settings that differ from the code's default and are not secret.
#
# Read deploy/env/README.md first. In short: everything here is a decision that belongs in review;
# no credential is ever in this file, and a test enforces that. The ~21 secret settings are merged
# in on the host at deploy time from the SOPS-encrypted file in Billykat7/infra.
#
# A setting not named here runs on its default in src/core/config.py. Add a line only to change
# one, so the diff of this file is the diff of the environment.
# docs/CICD/ENVIRONMENTS.md is the table of what differs between environments, and why.

# ── What environment this is ──────────────────────────────────────────────────────────────────
# Switches on the production rules in Settings.configuration_problems(): a real JWT secret, bcrypt
# 12 or more, no debug, no wildcard CORS, no /docs, no /dev pages, no test error route.
ENVIRONMENT=production

# ── Behind the gateway ────────────────────────────────────────────────────────────────────────
# The edge nginx in Billykat7/infra terminates TLS and sets X-Forwarded-For. Only behind a real
# proxy may the app believe that header; a client could otherwise choose its own address.
TRUST_PROXY_HEADERS=true

# Absolute links in outgoing email and in OAuth redirects. Not a secret: it is on every page.
PUBLIC_BASE_URL=https://clinicq.bkatalayi.com

# ── Observability ─────────────────────────────────────────────────────────────────────────────
# /metrics is served; METRICS_TOKEN (a secret) is what gates it. The app refuses to start with
# metrics on and no token outside development, so the two always ship together.
METRICS_ENABLED=true

# Ship the application log to the shared platform bucket. Credentials come from the secrets file.
AWS_S3_LOGGING_ENABLED=true

# Errors go to the production Sentry project (SENTRY_DSN is a secret). Traces cost money on the
# free tier; errors alone are what production needs.
SENTRY_TRACES_SAMPLE_RATE=0.0

# ── The compose file's own keys (not app settings; infra/docker/docker-compose.prod.yml) ──────
# The port the container is published on, bound to 127.0.0.1 — the gateway reaches it, nobody else.
APP_PORT=8011

# The FQDN, which selects the edge certificate the container mounts read-only to report expiry.
DOMAIN=clinicq.bkatalayi.com

# This product's slice of the shared platform host.
PROJECT_SLUG=clinicq
DB_SCHEMA=clinicq
